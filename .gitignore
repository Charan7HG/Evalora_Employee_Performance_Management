!.env.example
!deploy/.env.docker.example

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.log

# Node / React
node_modules/
dist/
build/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Local agent scaffolding (not project assets)
.freebuff/
.github/modernize/

# OS
Thumbs.db
.DS_Store

# Generated verification output (local test/lint/build logs)
test-output*.txt
*-output*.txt

# Test and build tooling caches
coverage/
.nyc_output/
.eslintcache
*.tsbuildinfo

# Local private keys and certificates (never commit)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
