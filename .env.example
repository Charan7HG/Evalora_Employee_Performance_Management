# ---------------------------------------------------------------------------
# Evalora - local environment variables (EXAMPLE FILE, no real values)
# Copy this file to .env and fill in your own local values.
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Local PostgreSQL database (never point this at a remote/production server)
DB_URL=jdbc:postgresql://localhost:5432/evalora
DB_USERNAME=evalora_app
DB_PASSWORD=replace-with-your-local-password

# Generate with: openssl rand -hex 32   (must be at least 32 characters)
# Required: the backend refuses to start when this is missing or too short.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRATION=28800000

# Gmail SMTP settings. Only used when the `gmail` profile is active, which the
# local development profile is not. Keep email disabled locally so no real
# message is ever sent from a laptop. The password must be a Google App
# Password, never the normal account password.
EVALORA_EMAIL_ENABLED=false
EVALORA_SMTP_HOST=smtp.gmail.com
EVALORA_SMTP_PORT=587
EVALORA_SMTP_USERNAME=
EVALORA_SMTP_PASSWORD=
EVALORA_MAIL_FROM_ADDRESS=
EVALORA_MAIL_FROM_NAME=Evalora

# Optional: Flyway location override. Leave unset for local development when
# starting the backend from the backend/ directory. Containers use the copy
# packaged in the jar, or an absolute external folder.
# MIGRATIONS_LOCATION=classpath:db/migration
# MIGRATIONS_LOCATION=filesystem:C:/path/to/evalora/database/migrations

# Local development profile: enables the HR bootstrap and the development
# password-reset token. Production must set a non-dev value (for example
# "prod") so those dev-only beans stay disabled.
SPRING_PROFILES_ACTIVE=dev

# Browser origins allowed to call the API (comma-separated). The default is the
# local Vite server; production sets the deployed frontend origin.
# EVALORA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend origin used in emailed activation links. It must be reachable from the
# device that opens the email. For temporary phone testing on the same Wi-Fi use
# the laptop's IPv4 address (for example http://192.168.1.20:5173), not localhost,
# and set EVALORA_CORS_ALLOWED_ORIGINS to the same origin. Production uses the
# real HTTPS frontend domain.
# EVALORA_FRONTEND_URL=http://localhost:5173

# Dev-only bootstrap HR account. Used only when the `dev` profile is active.
# Leave both empty to skip bootstrapping; never commit real credentials.
EVALORA_BOOTSTRAP_HR_EMAIL=
EVALORA_BOOTSTRAP_HR_PASSWORD=
# Optional profile fields (defaults shown):
# EVALORA_BOOTSTRAP_HR_EMPLOYEE_CODE=HR-001
# EVALORA_BOOTSTRAP_HR_FULL_NAME=HR Administrator
