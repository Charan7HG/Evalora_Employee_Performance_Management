# =============================================================================
# Evalora - Docker Compose environment template
#
# This is a TEMPLATE. It contains placeholders only, never real credentials.
# Copy it to a local file (for example deploy/.env.docker), fill in your own
# values, and keep the real file out of Git.
#
#   Copy-Item deploy/.env.docker.example deploy/.env.docker
#
# The Compose configuration supplies SPRING_PROFILES_ACTIVE=prod explicitly,
# so it is intentionally not listed here.
# =============================================================================

# Name of the PostgreSQL database created inside the database container.
DB_NAME=evalora

# PostgreSQL user. The SAME username is shared by two services:
#   - the PostgreSQL container creates this role, and
#   - the Spring Boot backend uses it to connect.
DB_USERNAME=evalora_app

# Password for DB_USERNAME. The SAME value is shared by the PostgreSQL
# container and the backend.
# Replace this placeholder with a strong, unique local password.
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD

# HMAC signing secret for backend JWTs.
# Replace this placeholder with a strong random value of AT LEAST 32 BYTES.
# Example generator: openssl rand -hex 32
# Never reuse the value from another environment.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# ---------------------------------------------------------------------------
# Email delivery for production.
#
# docker-compose.yml activates SPRING_PROFILES_ACTIVE=prod,gmail, so Gmail SMTP
# is the production provider. Set EVALORA_EMAIL_ENABLED=true once the App
# Password below is filled in. The password must be a Google App Password
# (https://myaccount.google.com/apppasswords), never the account password.
#
# Brevo remains available when the `gmail` profile is removed from the Compose
# profile list; leave EVALORA_BREVO_API_KEY empty unless you switch back.
# ---------------------------------------------------------------------------
EVALORA_EMAIL_ENABLED=false
EVALORA_SMTP_HOST=smtp.gmail.com
EVALORA_SMTP_PORT=587
EVALORA_SMTP_USERNAME=your-verified-sender@gmail.com
EVALORA_SMTP_PASSWORD=CHANGE_ME_TO_A_GOOGLE_APP_PASSWORD
EVALORA_MAIL_FROM_ADDRESS=your-verified-sender@gmail.com
EVALORA_MAIL_FROM_NAME=Evalora
EVALORA_BREVO_API_KEY=
EVALORA_FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the backend.
EVALORA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# OTP pepper for HMAC-SHA256 hashing. Must be a strong, secret value.
# Change from the default placeholder before production.
EVALORA_OTP_PEPPER=CHANGE_ME_TO_A_STRONG_OTP_PEPPER

# OTP request rate limiting configuration.
EVALORA_OTP_MAX_ATTEMPTS=5
EVALORA_OTP_RESEND_COOLDOWN=60

# ---------------------------------------------------------------------------
# Optional isolated E2E Compose override configuration.
# These values are used only with deploy/docker-compose.e2e.yml.
# Use a unique disposable volume/network name for the isolated project.
# ---------------------------------------------------------------------------
EVALORA_E2E_HR_EMAIL=
EVALORA_E2E_HR_PASSWORD=
EVALORA_E2E_HR_EMPLOYEE_CODE=
EVALORA_E2E_HR_FULL_NAME=
EVALORA_E2E_POSTGRES_VOLUME=
EVALORA_E2E_NETWORK=
